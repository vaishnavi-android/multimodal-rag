{
  "info": {
    "name": "Multimodal Bucket-Based RAG",
    "description": "Verifies /health, /ingest, /query, bucket isolation, and source traceability per the project spec.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8000" }
  ],
  "item": [
    {
      "name": "1. Health Check",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/health"
      }
    },
    {
      "name": "2. Ingest All Buckets",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{base_url}}/ingest",
        "body": {
          "mode": "raw",
          "raw": "{}"
        }
      }
    },
    {
      "name": "3. Ingest Bucket 1 Only",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{base_url}}/ingest",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"bucket_id\": \"bucket_1\"\n}"
        }
      }
    },
    {
      "name": "4. Query Bucket 1",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{base_url}}/query",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"bucket_id\": \"bucket_1\",\n  \"query\": \"Replace with a question you know Bucket 1 documents can answer\"\n}"
        }
      }
    },
    {
      "name": "5. Query Bucket 2",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{base_url}}/query",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"bucket_id\": \"bucket_2\",\n  \"query\": \"Replace with a question you know Bucket 2 documents can answer\"\n}"
        }
      }
    },
    {
      "name": "6. Bucket Isolation Test (Bucket-2 topic asked against Bucket 1)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{base_url}}/query",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"bucket_id\": \"bucket_1\",\n  \"query\": \"Ask about a topic that ONLY exists in Bucket 2 - expect a 'not found' style answer, never Bucket-2 content.\"\n}"
        }
      }
    }
  ]
}
